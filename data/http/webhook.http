### Test response.received webhook (update-task response)
POST http://localhost:4244/webhook/response-received
Content-Type: application/json

{
  "eventType": "response.received",
  "runId": "507f1f77bcf86cd799439011",
  "taskId": "507f191e810c19729de860ea",
  "requestId": "507f191e810c19729de860eb",
  "workflowId": "deploy-workflow",
  "timestamp": 1234567880,
  "run": {
    "id": "507f1f77bcf86cd799439011",
    "name": "deploy-workflow",
    "businessId": "BIZ-2024-001",
    "status": "running",
    "tasks": [],
    "events": [],
    "inputParameters": {},
    "livingParameters": {},
    "outputParameters": {}
  },
  "response": {
    "id": "507f191e810c19729de860ed",
    "action": "ADD_SIGN",
